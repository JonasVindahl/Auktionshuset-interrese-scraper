# Auktionshuset Hunter — konfiguration
#
# Kopiér til .env og udfyld. Filen er i .gitignore.

# --- Discord (påkrævet for notifikationer) ---------------------------------
# Vælg ÉN af disse tre måder. Den første der er sat vinder.

# 1. Direkte i miljøet (nemmest til lokal brug):
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXX/YYYYYYY

# 2. Fra en fil (Docker secrets-stil):
# DISCORD_WEBHOOK_URL_FILE=/run/secrets/discord_webhook

# 3. Indirekte: navnet på en anden miljøvariabel der indeholder webhooken.
# DISCORD_WEBHOOK_URL_FROM_ENV=MIN_HEMMELIGE_VARIABEL

# --- Overvågning -----------------------------------------------------------
# Interval i sekunder. Minimum 900 (15 min) håndhæves i koden.
SCRAPE_INTERVAL_SECONDS=900

# Regioner (kommasepareret) eller 'all' for alle landsdele.
# Se region-id'er i config/interests.yml under 'regions'.
REGION_IDS=all
# Visa namn i beskederne. Udledes ellers af region_ids.
# REGION_LABEL=Hele Danmark

# 1 = kun aktive auktioner, 0 = afsluttede, 2 = alle
AUCTION_STATUS=1

# --- Beskeder ud over nye fund --------------------------------------------
# Et lot du følger eller har budt på kan give to slags ekstra beskeder.
# Prisstigninger sendes højst hver 12. time pr. lot, så en travl auktion ikke
# fylder kanalen. Sidste chance kommer én gang, når der er under en time til
# hammerslag. Begge kan slås fra.
# PRICE_ALERTS=1
# LAST_CHANCE_ALERTS=1
# LAST_CHANCE_HOURS=1

# --- Budget (overrider interests.yml) --------------------------------------
# Samlet loft i kroner. Sættes pr. kategori i interests.yml.
MAX_PRICE=1000

# Hvor meget over loftet der stadig rapporteres (2.5 = op til 2500 kr).
SOFT_OVER_BUDGET_FACTOR=2.5

# Pris for at afgive første bud på et lot uden bud.
OPENING_BID=50

# --- AI-trin (valgfrit) ----------------------------------------------------
# Et sprogmodeltrin der kun kører på lots der allerede har matchet på nøgleord.
# Det fjerner støj som 'Div. lydudstyr: DVI-forlængere, HDD-adaptere mv.' og
# sender grænsetilfælde i et samlet digest i stedet for én ad gangen.
#
# Uden nøglen kører agenten videre uden AI — den fejler ikke.
#
# Alle nedenstående er kommenteret ud, så config/interests.yml er standarden.
# Sætter du dem her, vinder de over YAML-filen.

# Slå til uden at redigere YAML:
# CLASSIFIER_ENABLED=1

# API-nøgle. Vælg ÉN af tre måder, som for Discord ovenfor.
# CLASSIFIER_API_KEY=sk-...
# CLASSIFIER_API_KEY_FILE=/run/secrets/classifier_api_key
# CLASSIFIER_API_KEY_FROM_ENV=MIN_OPENAI_NOEGLE
# Alternativt: OPENAI_API_KEY (bruges hvis CLASSIFIER_API_KEY ikke er sat).

# Enhver OpenAI-kompatibel endpoint kan bruges:
# OpenAI:     https://api.openai.com/v1   (model: gpt-4o-mini)
# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://ollama:11434/v1      (lokal model, ingen omkostning)
# CLASSIFIER_MODEL=gpt-4o-mini
# CLASSIFIER_BASE_URL=https://api.openai.com/v1

# Loft pr. kørsel, så en fejlkonfiguration ikke løber med budgettet.
# Fund ud over loftet udskydes til næste kørsel i stedet for at sendes ufiltreret.
# CLASSIFIER_MAX_PER_RUN=25
# CLASSIFIER_TIMEOUT=30

# --- Teknisk ---------------------------------------------------------------
LOG_LEVEL=INFO
# CONFIG_PATH=/app/config/interests.yml
# DB_PATH=/app/data/auction_hunter.db

# ---------------------------------------------------------------------------
# Webdashboard
# ---------------------------------------------------------------------------
# Adgangskode foran hele dashboardet. Siden kan redigere interesseprofilen og
# markere fund, så den bør ikke stå åben — heller ikke på et hjemmenetværk.
# Er den ikke sat, kører dashboardet åbent, og det logges som en advarsel.
# WEB_PASSWORD=vælg-noget-langt-her

# Kan også læses fra en fil eller en anden variabel, som de øvrige hemmeligheder:
# WEB_PASSWORD_FILE=/run/secrets/web_password
# WEB_PASSWORD_FROM_ENV=MIN_VARIABEL

# Nøglen der signerer login-cookien. Uden den laves en tilfældig ved opstart,
# hvilket logger dig ud hver gang containeren genstarter.
# Lav en med: python -c "import secrets; print(secrets.token_urlsafe(48))"
# WEB_SECRET_KEY=

# Kraev HTTPS for login-cookien. Udledes ellers af WEB_BASE_URL.
# Saet den til 0 hvis du bevidst koerer http bag en proxy.
# WEB_COOKIE_SECURE=1
# WEB_BASE_URL=https://hunter.jonasvindahl.dk

# Kun disse Host-headere accepteres (kommasepareret). Tom = ingen kontrol.
# Slaa til bag et domaene, saa en DNS-rebinding ikke kan naa dashboardet.
# ALLOWED_HOSTS=hunter.jonasvindahl.dk

# Bag en reverse proxy: hvilke IP'er der maa saette X-Forwarded-Proto og
# X-Forwarded-For. Kun lokalhost som standard.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Assistenten på /chat bruger samme nøgle som AI-trinnet (CLASSIFIER_API_KEY).
# Er den ikke sat, virker siden stadig — som en almindelig nøgleordssøgning.

# ---------------------------------------------------------------------------
# Billedcache
# ---------------------------------------------------------------------------
# Auktionshuset fjerner et lots billede når auktionen lukker, så adressen er
# død netop når Udløbet-fanen skal bruge den. Agenten henter derfor miniaturen
# mens lot'et er aktivt — kun for fund, ikke for alle ~2.200 lots.
# Billederne ligger i data/images/ og fylder omkring 30 KB pr. fund.
# CACHE_IMAGES=1                 # sæt til 0 for at slå fra
# IMAGE_RETENTION_DAYS=180       # ryddes når lot'et har været slut så længe
# MAX_IMAGE_BYTES=512000         # større svar afvises
# Billedadresser der peger ind i det private net afvises. Sæt kun til 1 hvis
# du henter billeder fra en server på dit eget net.
# IMAGE_ALLOW_PRIVATE_HOSTS=0
